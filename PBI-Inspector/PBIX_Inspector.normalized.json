        {
          "id": "REDUZIR_VISUAIS_POR_PAGINA",
          "name": "[VISUAL] Reduza n\u00FAmero de visuais por p\u00E1gina",
          "description": "Essa p\u00E1gina cont\u00E9m mais de 15 gr\u00E1ficos ou cards visiveis, divida em p\u00E1ginas os visuais, identifique oportunidades de reduzir n\u00FAmero de visuais como por exemplo o card novo com a op\u00E7\u00E3o de multiplos visuais ou utilizar o bookmark para reduzir o n\u00FAmero visuais visiveis",
          "logType": "warning",
          "disabled": false,
          "part": "Pages",
          "test": [
            {
              "\u003C=": [
                {
                  "count": [
                    {
                      "filter": [
                        {
                          "part": "Visuals"
                        },
                        {
                          "and": [
                            {
                              "!": [
                                {
                                  "var": "isHidden"
                                }
                              ]
                            },
                            {
                              "!": [
                                {
                                  "in": [
                                    {
                                      "var": "visual.visualType"
                                    },
                                    [
                                      "shape",
                                      "actionButton",
                                      "textbox",
                                      "image",
                                      "bookmarkNavigator",
                                      "pageNavigator"
                                    ]
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "var": "paramMaxVisualsPerPage"
                }
              ]
            },
            {
              "paramMaxVisualsPerPage": 15
            },
            true
          ],
